  "main_conclusions": [
    "Apify 最接近一账号、一付款入口、一套执行 API；完整九站评论应视为多个 Actor 组合，schema、作者和数据深度并不统一。",
    "Scrapingdog Amazon Reviews 官方文档明确暂不可用，不能因为导航和营销页面仍在就列为可用。Walmart 评论端点可作为较窄备选。",
    "ScraperAPI Amazon Reviews 官方旧文档声明不可用，原同步 URL 重定向 Product API，后者仅承诺公开商品页可见评论；不能等同完整历史评论。",
    "Temu 社区新 Actor 虽宣称正文，但页面仅 2 total users/1 monthly active，缺少成熟证据，暂不列为已验证生产覆盖。",
    "研究仅核对官方文档、Actor 作者在 Apify 的页面和公开只读元数据；未注册、未运行采集、未付费、未验证实际响应。"
  ],
  "evidence_interpretation": {
    "process_success_not_data_quality": "publicActorRunStats30Days 的 SUCCEEDED 是执行状态，不保证有评论、不保证正文完整、不代表目标 ASIN/国家成功率。",
    "rating_not_sla": "用户评分、用户数、最近更新只是维护/采用证据，不是 SLA 或稳定性实测。",
    "metadata_vs_cached_pages": "网页抓取和搜索缓存中的用户数/价格可滞后；metadata_snapshots 保留本次直连官方公开 API 的时间戳与最新有效计价。",
    "review_not_rating": "ratings 总数可含无文字评分；评论文字数量通常小于星级总数。eBay 商品评论与 seller feedback 应分表或至少保留类型。",
    "one_endpoint_limit": "Apify 统一的是执行接口；不同 Actor 的输入、输出、价格和分页语义仍不同。"
  },
