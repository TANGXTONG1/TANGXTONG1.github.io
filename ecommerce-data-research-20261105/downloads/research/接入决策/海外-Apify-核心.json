  "unified_api_contract": {
    "start": {
      "method": "POST",
      "url": "https://api.apify.com/v2/actors/{owner}~{actor}/runs",
      "headers": {
        "Authorization": "Bearer <APIFY_API_TOKEN>",
        "Content-Type": "application/json"
      },
      "query": "build=<validated-build>&timeout=<seconds>&restartOnError=false&maxTotalChargeUsd=<budget>"
    },
    "poll": {
      "method": "GET",
      "url": "https://api.apify.com/v2/actor-runs/{runId}",
      "read": [
        "data.status",
        "data.defaultDatasetId",
        "data.usageTotalUsd",
        "data.chargedEventCounts",
        "data.buildNumber"
      ]
    },
    "export": {
      "method": "GET",
      "url": "https://api.apify.com/v2/datasets/{defaultDatasetId}/items?format=json&clean=false&offset=0&limit=1000",
      "pagination": "每页按原始返回行数推进 offset；先完成全量读取再做有效评论过滤，避免过滤后 offset 跳错。CSV 可用 format=csv。",
      "storage": "任务终态后立即读取到自己的数据库并记录 source、actor、build、run 时间；不要公开 token 或账户 dataset ID。"
    },
    "architecture": "后端统一 start/poll/export/预算/重试模块 + 每站 input builder 与 output mapper；业务端只调用自己的统一评论接口。",
    "limits_and_retries": [
      "轮询有退避；HTTP 请求超时不代表 Actor 已停止，必须先查 runId 再决定是否重启，以免重复计费。",
      "失败重试设置应用层次数和总预算；预算值为上限，不是预扣费用；Dataset limit 只限制下载页，不限制采集量。",
      "记录 Actor 终态和有效行数两套成功指标；SUCCEEDED + 0 条不得按抓到评论成功。",
      "本次未核验账号专属限额，不把公开 API 的高请求率当作目标电商保证吞吐。"
    ],
    "sources": [
